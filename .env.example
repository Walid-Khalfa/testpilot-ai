# TestPilot AI environment variables

# Local demo mode: allow localhost targets (development only)
ALLOW_LOCAL_DEMO=true

# Local data directory for file-based storage
DATA_DIR=.data

# Concurrency
MAX_CONCURRENT_RUNS=2

# Modal (Meta Muse Spark Open shared endpoint) - required for live inference
# Create a proxy token: `modal workspace proxy-tokens create`
# Combine token id and secret with a period: wk-<id>.ws-<secret>
MODAL_PROXY_TOKEN=
MODAL_MODEL_ID=meta-models--muse-spark-open-816b-a42b.us-west.modal.direct
MODAL_ENDPOINT_BASE_URL=https://inference.us-west.modal.direct/v1
MODAL_WORKSPACE=khelfawalid